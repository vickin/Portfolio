# Web3Forms — https://web3forms.com (free: unlimited submissions)
# Create a form at web3forms.com, confirm your email, then copy the access key.
WEB3FORMS_ACCESS_KEY=your_access_key_here

# Upstash Redis — https://upstash.com (free: 10,000 commands/day)
# Create a Redis database, then copy the REST URL and token from the dashboard.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
