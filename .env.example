# Resend — https://resend.com (free: 3,000 emails/month)
# Create an account, verify your domain or use the sandbox, then copy the API key.
RESEND_API_KEY=re_your_api_key_here

# Upstash Redis — https://upstash.com (free: 10,000 commands/day)
# Create a Redis database, then copy the REST URL and token from the dashboard.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
